#!/usr/bin/env bash
#
# jayos-denoise, the 1.x engine's command, kept for what still calls it.
#
#   jayos-denoise status                          jayos-audio denoise status
#   jayos-denoise strengths                       jayos-audio denoise strengths
#   jayos-denoise preset <strength> [off]         jayos-audio denoise config <strength>
#   jayos-denoise set on|off [strength]           jayos-audio denoise on [strength] | off
#   jayos-denoise apply on|off [strength] [--force]
#                                                 jayos-audio denoise apply ...
#
# 2.0.0 moved the filter out of EasyEffects into a PipeWire filter-chain host
# of its own, and the package was renamed jayos-audio (src/jayos-audio says
# why). A preset is no longer written, so `preset` prints the host's
# configuration, and its `off` is accepted and ignored. Everything else is the
# old verbs onto the new ones.

set -uo pipefail

ENGINE="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/jayos-audio"

case "${1:-}" in
    status|strengths) exec "$ENGINE" denoise "$1" ;;
    preset)           exec "$ENGINE" denoise config "${2:-}" ;;
    set)
        case "${2:-}" in
            on)  exec "$ENGINE" denoise on ${3:+"$3"} ;;
            off) exec "$ENGINE" denoise off ;;
            *)   echo "usage: jayos-denoise set on|off [strength]" >&2; exit 1 ;;
        esac ;;
    apply)            shift; exec "$ENGINE" denoise apply "$@" ;;
    *)                echo "usage: jayos-denoise status|preset|set|apply|strengths" >&2; exit 1 ;;
esac
