+// A host destroys an instance through LADSPA's cleanup(), which drops it.
+// The worker is told to stop and then joined, so that by the time cleanup()
+// returns the thread is gone: not left polling every half millisecond with a
+// model in memory for the life of the host, and not still running this
+// library's code when the host unloads it -- EasyEffects dlcloses the plugin
+// when it destroys its wrapper (LadspaWrapper::~LadspaWrapper). cleanup() is
+// never called from the real-time thread, and the join waits at most one
+// poll sleep or one frame of inference.
+impl Drop for DfPlugin {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(worker) = self.worker.take() {
+            match worker.join() {
+                Ok(()) => log::info!("DF {} | Worker joined", self.id),
+                Err(_) => log::warn!("DF {} | Worker had panicked; joined", self.id),
+            }
+        }
+    }
+}
