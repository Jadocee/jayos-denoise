--- /dev/null
+++ b/ladspa/tests/worker_exits.rs
@@ -0,0 +1,57 @@
+//! A plugin's worker thread ends with the plugin.
+//!
+//! Before jayos-denoise's packaging/patches/0002, the worker's loop had no way
+//! out and its JoinHandle was dropped, which detaches it: every instance a host
+//! destroyed left a thread polling every half millisecond, with its model in
+//! memory, for the rest of the host's life (EasyEffects issue #4652). Counted
+//! in /proc/self/task, which lists this process's threads, so this binary holds
+//! one test: nothing else here starts or ends a thread while it counts.
+
+use std::fs;
+use std::thread::sleep;
+use std::time::{Duration, Instant};
+
+use deep_filter_ladspa::get_ladspa_descriptor;
+
+const SR: u64 = 48000;
+
+fn threads() -> usize {
+    fs::read_dir("/proc/self/task").map(|d| d.count()).unwrap_or(0)
+}
+
+/// The thread count once it has settled at `want`, or what it was after a
+/// second. A joined thread has exited, but the count is read from /proc, which
+/// is allowed to lag the exit by a moment.
+fn settled(want: usize) -> usize {
+    let t0 = Instant::now();
+    loop {
+        let n = threads();
+        if n == want || t0.elapsed() > Duration::from_secs(1) {
+            return n;
+        }
+        sleep(Duration::from_millis(5));
+    }
+}
+
+#[test]
+fn dropping_a_plugin_ends_its_worker() {
+    assert!(threads() > 0, "no /proc/self/task to count this process's threads in");
+    for (idx, label) in [(0u64, "mono"), (1u64, "stereo")] {
+        let desc = get_ladspa_descriptor(idx).expect("no descriptor");
+
+        // One instance made and dropped first, so a pool a library starts once
+        // and keeps is in the baseline. A worker that outlives its plugin is
+        // in it too -- and then every round below adds another.
+        drop((desc.new)(&desc, SR));
+        let base = settled(threads());
+
+        for round in 1..=3 {
+            let mut plugin = (desc.new)(&desc, SR);
+            plugin.activate();
+            assert!(threads() > base, "{label}, round {round}: a live plugin has no worker");
+            plugin.deactivate();
+            drop(plugin);
+            assert_eq!(settled(base), base, "{label}, round {round}: the worker outlived its plugin");
+        }
+    }
+}
