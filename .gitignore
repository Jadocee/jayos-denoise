# What makepkg leaves beside packaging/arch/PKGBUILD: the fork's bare mirror
# (one per git source, named by its folder:: prefix), the extracted sources,
# the staged package, the package files and the logs.
packaging/arch/DeepFilterNetPlus/
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/*.pkg.tar*
packaging/arch/*.log
# cargo's output for rust/, the two programs' workspace: packaging/steps.sh
# builds into rust/target wherever the building user's CARGO_TARGET_DIR
# points, and so does a `cargo build` run by hand in rust/.
rust/target/
